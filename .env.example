# Environment Variables for Fiscal Agent
# Copy this file to `.env` and fill in the provider block you want to use.

# =========================
# Core runtime
# =========================
DATABASE_URL=postgresql://fiscal_user:fiscal_pass@localhost:5432/fiscal_agent
LLM_PROVIDER=gemini
PORT=8000
HOST=0.0.0.0
AGNO_DEBUG=true
AGNO_LOG_LEVEL=INFO
AGNO_RELOAD=false
APP_ENV=development

# A tabela `tax_knowledge.embedding` usa vector(768) por padrão.
# Se alterar o modelo de embedding para outra dimensão, ajuste também o schema SQL.
EMBEDDING_DIMENSIONS=768

# =========================
# Gemini
# =========================
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_ID=gemini-2.0-flash-001
GEMINI_EMBEDDING_MODEL_ID=gemini-embedding-001

# =========================
# Ollama local ou cloud
# =========================
# Para localhost, use um host como http://localhost:11434
# Para cloud, você pode definir OLLAMA_API_KEY e opcionalmente OLLAMA_BASE_URL.
OLLAMA_HOST=
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL_ID=llama3.2
OLLAMA_EMBEDDING_MODEL_ID=nomic-embed-text

# =========================
# Hugging Face
# =========================
HF_TOKEN=
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=
HUGGINGFACE_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_EMBEDDING_MODEL_ID=sentence-transformers/all-mpnet-base-v2

# ElevenLabs Text-to-Speech
ELEVEN_LABS_API_KEY=your-elevenlabs-api-key-here
